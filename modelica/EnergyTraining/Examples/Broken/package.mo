within EnergyTraining.Examples;
package Broken "Session 4: models with deliberate errors, to diagnose from the simulation log (G4.1)"
  extends Modelica.Icons.ExamplesPackage;
  annotation (Documentation(info="<html>
<p>Each model here has <b>one deliberate error</b>. They are exercise material for Session 4
(G4.1): simulate, read the log, write a diagnosis, then fix the model. Do not use them as
building blocks. The fixed versions are published with the solutions after the session.</p>
</html>"));
end Broken;
